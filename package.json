  "scripts": {
    "build": "cd server && npm install && npm run build",
    "server:start": "node server/dist/index.js",
    "expo:start": "expo start",
    "web:start": "expo start --web",
    "start": "concurrently --kill-others --names \"server,expo\" --prefix-colors \"blue,green\" \"npm run server:start\" \"npm run expo:start\"",
    "web": "concurrently --kill-others --names \"server,web\" --prefix-colors \"blue,green\" \"npm run server:start\" \"npm run web:start\"",
    "check": "npm run lint && npx tsc --noEmit && npm run build",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "type:gen": "npx -y supabase gen types typescript --project-id kgjixulwpzurcedwwnor > src/types/supabase.ts"
